    },
    "Reachability": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँच"
          }
        }
      }
    },
    "Reachable now": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पहुँच में"
          }
        }
