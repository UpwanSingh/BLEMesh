          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि हटाएँ"
          }
        }
      }
    },
    "Removing someone, or anyone leaving, changes the group key so they can't read new messages.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी को हटाने या किसी के छोड़ने पर समूह की कुंजी बदल जाती है, ताकि वे नए संदेश न पढ़ सकें।"
          }
        }
      }
    },
    "Replay introduction": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिचय फिर से देखें"
