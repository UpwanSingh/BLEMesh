          }
        }
      }
    },
    "Your phone talks directly to nearby phones over Bluetooth and passes messages along for others. No SIM, Wi-Fi, account or server needed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोन Bluetooth से सीधे पास के फ़ोन से बात करता है और दूसरों के संदेश आगे पहुँचाता है। न SIM, न Wi-Fi, न अकाउंट, न सर्वर चाहिए।"
