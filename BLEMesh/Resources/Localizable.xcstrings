        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीसेट करें"
          }
        }
      }
    },
    "Reset all settings to defaults?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारी सेटिंग्स पहले जैसी कर दें?"
          }
        }
      }
    },
    "Reset settings": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स रीसेट करें"
          }
        }
      }
    },
    "Resolved": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल हो गया"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से भेजें"
          }
        }
      }
    },
    "Roles are shared with nearby phones so people with emergencies can find you. The auto-reply never says you're safe — only that you haven't answered, your battery, and when you were last active.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूमिकाएँ आस-पास के फ़ोन से साझा होती हैं ताकि मुसीबत में फँसे लोग आपको ढूँढ सकें। अपने-आप जवाब कभी नहीं कहता कि आप सुरक्षित हैं — बस यह कि आपने जवाब नहीं दिया, आपकी बैटरी, और आप आख़िरी बार कब सक्रिय थे।"
          }
        }
      }
    },
    "S": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दक्षिण"
          }
        }
      }
    },
    "SE": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दक्षिण-पूर्व"
          }
        }
      }
    },
    "SOS": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS"
          }
        }
      }
    },
    "SOS board (%lld)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS बोर्ड (%lld)"
          }
        }
      }
    },
    "SOS sent to everyone in range": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँच में सभी को SOS भेजा गया"
          }
        }
      }
    },
    "SOS to everyone nearby": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास सभी को SOS"
          }
        }
      }
    },
    "SW": {
      "extractionState": "manual",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दक्षिण-पश्चिम"
          }
        }
      }
    },
    "Safety & privacy": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा और निजता"
          }
        }
      }
    },
    "Safety numbers (theirs, then yours)": {
      "localizations": {
        "hi": {
          "stringUnit": {
