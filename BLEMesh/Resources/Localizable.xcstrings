    "Direct and group messages are encrypted on your phone. Phones that relay them can't read them. Compare safety numbers to verify a contact.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी और समूह संदेश आपके फ़ोन पर ही एन्क्रिप्ट होते हैं। उन्हें आगे भेजने वाले फ़ोन उन्हें पढ़ नहीं सकते। संपर्क की पुष्टि के लिए सुरक्षा नंबर मिलाएँ।"
          }
        }
      }
    },
